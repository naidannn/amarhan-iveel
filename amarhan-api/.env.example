# ── Заавал ─────────────────────────────────────────────────────────────────
# Эдгээр байхгүй бол апп эхлэхгүй (src/config/index.js)
PORT=4000
APP=amarhan-api
# ХҮЧТЭЙ, САНАМСАРГҮЙ утга ашиглана. Үүсгэх: openssl rand -base64 48
APP_SECRET=

# Транзакц ашиглахын тулд replicaSet заавал (docs/architecture.md §4.3)
MONGOURI=mongodb://localhost:27017/amarhan?replicaSet=rs0&directConnection=true

# ── Ерөнхий ────────────────────────────────────────────────────────────────
NODE_ENV=development
# SESSION_SECRET хэрэггүй болов (Phase 5): танилт бүхэлдээ JWT дээр тогтох
# болсон тул `express-session` устгагдсан.
# Таслалаар тусгаарлана. Production-д зөвхөн бодит домэйн бичнэ.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────────────────
# Ажилтны токен — ажлын нэг ээлжийн урт
JWT_STAFF_EXPIRES_IN=8h
# Харилцагчийн токен (Phase 5)
JWT_CUSTOMER_EXPIRES_IN=30d

# ── Rate limit ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Анхны админ (npm run seed:admin) ───────────────────────────────────────
# ADMIN_PASSWORD өгөөгүй бол санамсаргүй нууц үг үүсгэж нэг удаа хэвлэнэ
ADMIN_EMAIL=admin@iveel.mn
ADMIN_PASSWORD=

# ── Google OAuth — ЗӨВХӨН харилцагчийн нэвтрэлт (Phase 5, §3) ──────────────
# Гурвуулаа бөглөгдсөн үед л Google-ээр нэвтрэх боломж НЭЭГДЭНЭ. Дутуу бол
# харилцагч утас + нууц үгээр л нэвтэрнэ (алдаа өгөхгүй, чимээгүй унтарна).
#
# Ажилтныг Google-ээр нэвтрүүлэхгүй: ажилтны бүртгэлийг зөвхөн Админ үүсгэнэ (§9.1).
#
# GOOGLE_CALLBACK_URL нь Google Cloud Console-ийн "Authorized redirect URIs"-тай
# ЯГ ТААРАХ ёстой. Жишээ (локал):
#   http://localhost:4000/api/v1/customer/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── QPay (Phase 5) ─────────────────────────────────────────────────────────
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=

# ── SMS (Phase 6) ──────────────────────────────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=

# ── AWS S3 — файл хадгалалт (Phase 2) ──────────────────────────────────────
# Гурвуулаа байхгүй бол S3 үйлчилгээ ашиглах үед алдаа өгнө
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ── Redis (Phase 9) ────────────────────────────────────────────────────────
REDIS_URL=
