# Required
PORT=4000
APP=amarhan-api
APP_SECRET=your-jwt-secret-here
MONGOURI=mongodb://localhost:27017/amarhan

# Optional
NODE_ENV=development
MONGOTESTURI=mongodb://localhost:27017/amarhan-test
SESSION_SECRET=your-session-secret-here
CORS_ORIGINS=http://localhost:3000,http://localhost:3500
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
